{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "An amazing description here",
  "authors": [
    "sophur"
  ],
  "contact": {
    "sources": "https://github.com/${repo_github}"
  },
  "license": "MPL-2.0",
  "icon": "assets/boards/icon.png",
  "environment": "*",
  "accessWidener": "boards.classtweaker",
  "entrypoints": {
    "main": [
      "me.sophur.boards.BoardsMain"
    ],
    "client": [
      "me.sophur.boards.client.BoardsClient"
    ]
  },
  "mixins": [
    {
      "environment": "client",
      "config": "boards.client.mixins.json"
    },
    "boards.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}