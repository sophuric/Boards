{
  "multipart": [
    {
      "apply": {
        "model": "boards:block/frame_base"
      }
    },
    {
      "apply": {
        "fabric:type": "boards:frame_boards"
      }
    },
    {
      "when": {
        "north": false
      },
      "apply": {
        "model": "boards:block/frame_no_board",
        "uvlock": true
      }
    },
    {
      "when": {
        "east": false
      },
      "apply": {
        "model": "boards:block/frame_no_board",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": false
      },
      "apply": {
        "model": "boards:block/frame_no_board",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": false
      },
      "apply": {
        "model": "boards:block/frame_no_board",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "up": false
      },
      "apply": {
        "model": "boards:block/frame_no_board",
        "x": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "down": false
      },
      "apply": {
        "model": "boards:block/frame_no_board",
        "x": 90,
        "uvlock": true
      }
    }
  ]
}
